local WatermarkActive = false
local CurrentWatermark = nil

local function CreateWatermark()
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player:FindFirstChild("PlayerGui")
    
    if not playerGui then
        playerGui = Instance.new("ScreenGui")
        playerGui.Name = "PlayerGui"
        playerGui.Parent = player
    end
    
    local existing = playerGui:FindFirstChild("ChaosKiller_FullWatermark")
    if existing then
        existing:Destroy()
    end
    
    local WatermarkGui = Instance.new("ScreenGui")
    WatermarkGui.Name = "ChaosKiller_FullWatermark"
    WatermarkGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    WatermarkGui.ResetOnSpawn = false
    WatermarkGui.IgnoreGuiInset = true
    WatermarkGui.Parent = playerGui
    
    local textWidth = 180
    local textHeight = 40
    local spacingX = 200
    local spacingY = 70
    
    for row = -3, 12 do
        for col = -2, 10 do
            local textLabel = Instance.new("TextLabel")
            textLabel.Text = "Chaos Killer"
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextScaled = false
            textLabel.TextSize = 22
            textLabel.TextTransparency = 0.88
            textLabel.TextXAlignment = Enum.TextXAlignment.Center
            textLabel.TextYAlignment = Enum.TextYAlignment.Center
            textLabel.Font = Enum.Font.GothamBold
            textLabel.BackgroundTransparency = 1
            textLabel.BorderSizePixel = 0
            textLabel.Size = UDim2.new(0, textWidth, 0, textHeight)
            
            local offsetX = 0
            if math.abs(row) % 2 == 1 then
                offsetX = spacingX / 2
            end
            
            local posX = (col * spacingX) + offsetX
            local posY = (row * spacingY)
            
            textLabel.Position = UDim2.new(0, posX, 0, posY)
            textLabel.Rotation = -25
            textLabel.Parent = WatermarkGui
            
            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 1
            stroke.Color = Color3.fromRGB(0, 0, 0)
            stroke.Transparency = 0.92
            stroke.Parent = textLabel
        end
    end
    
    CurrentWatermark = WatermarkGui
    print("文字水印")
end

local function RemoveWatermark()
    if CurrentWatermark then
        CurrentWatermark:Destroy()
        CurrentWatermark = nil
    end
end

local function ToggleWatermark()
    WatermarkActive = not WatermarkActive
    if WatermarkActive then
        CreateWatermark()
        WindUI:Notify({
            Title = "水印",
            Content = "水印已开启",
            Icon = "eye",
            Duration = 2
        })
    else
        RemoveWatermark()
        WindUI:Notify({
            Title = "水印",
            Content = "水印已关闭",
            Icon = "eye-off",
            Duration = 2
        })
    end
end

local CoordinateLabel = nil
local CoordinateGui = nil

local function CreateCoordinateDisplay()
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player:FindFirstChild("PlayerGui")
    
    if not playerGui then
        playerGui = Instance.new("ScreenGui")
        playerGui.Name = "PlayerGui"
        playerGui.Parent = player
    end
    
    local existing = playerGui:FindFirstChild("CoordinateDisplayGui")
    if existing then
        existing:Destroy()
    end
    
    CoordinateGui = Instance.new("ScreenGui")
    CoordinateGui.Name = "CoordinateDisplayGui"
    CoordinateGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    CoordinateGui.ResetOnSpawn = false
    CoordinateGui.IgnoreGuiInset = true
    CoordinateGui.Parent = playerGui
    
    local background = Instance.new("Frame")
    background.Size = UDim2.new(0, 400, 0, 35)
    background.Position = UDim2.new(0.5, -200, 0, 10)
    background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    background.BackgroundTransparency = 0.5
    background.BorderSizePixel = 0
    background.Parent = CoordinateGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = background
    
    CoordinateLabel = Instance.new("TextLabel")
    CoordinateLabel.Size = UDim2.new(1, 0, 1, 0)
    CoordinateLabel.Position = UDim2.new(0, 0, 0, 0)
    CoordinateLabel.BackgroundTransparency = 1
    CoordinateLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    CoordinateLabel.TextScaled = false
    CoordinateLabel.TextSize = 16
    CoordinateLabel.Font = Enum.Font.GothamBold
    CoordinateLabel.TextXAlignment = Enum.TextXAlignment.Center
    CoordinateLabel.TextYAlignment = Enum.TextYAlignment.Center
    CoordinateLabel.Text = "获取坐标中..."
    CoordinateLabel.Parent = background
end

local function UpdateCoordinates()
    if not CoordinateLabel then return end
    
    local char = game:GetService("Players").LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local pos = char.HumanoidRootPart.Position
        local mapName = game:GetService("Workspace").Name or "未知地图"
        CoordinateLabel.Text = string.format(" 地图: %s  |  X: %.1f  |  Y: %.1f  |  Z: %.1f", mapName, pos.X, pos.Y, pos.Z)
    else
        CoordinateLabel.Text = "等待角色加载..."
    end
end

local CoordinateUpdateConnection = nil

local function StartCoordinateUpdates()
    if CoordinateUpdateConnection then
        CoordinateUpdateConnection:Disconnect()
        CoordinateUpdateConnection = nil
    end
    
    CoordinateUpdateConnection = game:GetService("RunService").RenderStepped:Connect(function()
        UpdateCoordinates()
    end)
end

local function StopCoordinateUpdates()
    if CoordinateUpdateConnection then
        CoordinateUpdateConnection:Disconnect()
        CoordinateUpdateConnection = nil
    end
end

local function RemoveCoordinateDisplay()
    if CoordinateGui then
        CoordinateGui:Destroy()
        CoordinateGui = nil
        CoordinateLabel = nil
    end
    StopCoordinateUpdates()
end

local CoordinateActive = false

local function ToggleCoordinateDisplay()
    CoordinateActive = not CoordinateActive
    if CoordinateActive then
        CreateCoordinateDisplay()
        StartCoordinateUpdates()
        WindUI:Notify({
            Title = "坐标显示",
            Content = "坐标显示已开启",
            Icon = "map-pin",
            Duration = 2
        })
    else
        RemoveCoordinateDisplay()
        WindUI:Notify({
            Title = "坐标显示",
            Content = "坐标显示已关闭",
            Icon = "map-pin-off",
            Duration = 2
        })
    end
end

